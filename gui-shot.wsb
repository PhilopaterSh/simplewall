<Configuration>
  <!-- GUI shell (G-1) screenshot verification in Windows Sandbox.
       Smart App Control on the host blocks freshly rebuilt unsigned exes;
       the sandbox has no such policy. Maps the repo read-only and
       bin\mergetest writable so the screenshot + crash log land on the
       host. Close the sandbox manually after reading the result. -->
  <VGpus>Disable</VGpus>
  <AudioInput>Disable</AudioInput>
  <VideoInput>Disable</VideoInput>
  <PrinterRedirection>Disable</PrinterRedirection>
  <ClipboardRedirection>Enable</ClipboardRedirection>
  <Networking>Enable</Networking>
  <MemoryInMB>4096</MemoryInMB>
  <MappedFolders>
    <MappedFolder>
      <HostFolder>D:\CV\Github\simplewall</HostFolder>
      <ReadOnly>true</ReadOnly>
    </MappedFolder>
    <MappedFolder>
      <HostFolder>D:\CV\Github\simplewall\bin\mergetest</HostFolder>
      <ReadOnly>false</ReadOnly>
    </MappedFolder>
  </MappedFolders>
  <LogonCommand>
    <Command>C:\Users\WDAGUtilityAccount\Desktop\simplewall\tools\gui-shot.cmd</Command>
  </LogonCommand>
</Configuration>
